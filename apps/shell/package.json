{
  "name": "racecor-prodrive-mac-shell",
  "version": "0.1.0",
  "description": "Native macOS Electron wrapper for RaceCor Pro Drive",
  "main": "src/main/index.js",
  "homepage": "https://prodrive.racecor.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/alternatekev/racecor-prodrive-mac-shell.git"
  },
  "author": "K10 Motorsports",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron src/main/index.js",
    "build": "npm run build:mac",
    "build:mac": "electron-builder --mac",
    "lint": "eslint src/",
    "test": "echo \"No tests configured yet\""
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^24.6.4",
    "eslint": "^8.52.0"
  },
  "build": {
    "appId": "racing.k10motorsports.prodrive.racecor.macshell",
    "productName": "RaceCor Pro Drive",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "src/",
      "assets/"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.sports",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": {
        "teamId": "${APPLE_TEAM_ID}"
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
