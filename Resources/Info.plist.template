<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- Points macOS at Assets.xcassets/AppIcon.appiconset. Without this
         key the Dock falls back to a generic document icon even when the
         asset catalog has valid PNGs, because Launch Services has no
         way to resolve "which icon set?" for apps with a catalog-based
         icon. This is the #1 reason the Dock keeps showing the default. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.sports</string>
    <!-- Prevents macOS from spawning a second process when a
         racecor-native:// URL is dispatched while the app is already
         running. Without this, Launch Services launches a fresh .app
         whose AuthManager has no pending PKCE verifier, so the OAuth
         exchange fails with the second window stuck on a spinner. -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSMainStoryboardFile</key>
    <string></string>
    <key>NSPrincipalClass</key>
    <string>$(PRINCIPAL_CLASS)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>RaceCor OAuth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>racecor-native</string>
            </array>
        </dict>
    </array>
    <!-- ★ .rcpdv (RaceCor Pro Drive Video) bundle format ★
         Declares our private UTI, conforming to public.mpeg-4 + public.movie
         so QuickTime / VLC / AVPlayer / Quick Look can still open a .rcpdv
         when explicitly pointed at it (the bytes are valid MP4). The custom
         extension exists for branding, custom file icons, and so the editor
         is the default open-with handler — without disturbing user-level
         .mp4 associations. Spec: agents/skills/race-bundle-format/ -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>racing.k10motorsports.prodrive.rcpdv</string>
            <key>UTTypeDescription</key>
            <string>RaceCor Pro Drive Bundle</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.mpeg-4</string>
                <string>public.movie</string>
                <string>public.audiovisual-content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>rcpdv</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>video/mp4</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>RaceCor Pro Drive Bundle</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>racing.k10motorsports.prodrive.rcpdv</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
